{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["chrome", "hammerjs", "jest", "node"]
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.d.ts",
    "*.config.js",
    "*.config.cjs",
    "*.config.mjs"
  ],
  "exclude": [
    "node_modules",
    ".codex",
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "previews",
    "vendor"
  ]
}
