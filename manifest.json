{
  "manifest_version": 3,
  "name": "UglyPadlet",
  "version": "2.0.19",
  "description": "Transforme les Padlets de l'ecole Elan en fils verticaux lisibles avec filtres.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://padlet.com/*/*"],
      "js": ["vendor/hammer.min.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
